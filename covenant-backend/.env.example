# Copy this file to .env and adjust for your local PostgreSQL setup.

DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/covenant

SECRET_KEY=replace-this-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

MAX_UPLOAD_MB=25
UPLOAD_DIR=uploads
